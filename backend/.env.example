# ==============================================================================
# WasteDash Backend — Environment Configuration Template
# Greater Chennai Corporation (GCC) Solid Waste Segregation & AI Dashboard
# ==============================================================================
# Instructions:
# 1. For local development: copy this file to .env (`cp .env.example .env`)
# 2. For Render production: configure these keys in the Render Service Environment Dashboard.
# 3. NEVER commit real secret credentials or database passwords to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=false
PROJECT_NAME="Chennai Solid Waste Segregation & AI Optimization Platform"
API_V1_STR=/api

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a strong 256-bit secret using: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_64_char_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web frontend domains
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://waste-22.onrender.com

# ------------------------------------------------------------------------------
# 4. Three Isolated Logical Databases (Strict Domain Separation)
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT (SQLite - 3 Independent Files):
USER_DATABASE_URL=sqlite:///./users.db
STAFF_DATABASE_URL=sqlite:///./staff.db
WASTE_DATABASE_URL=sqlite:///./waste_management.db

# PRODUCTION CONFIGURATION (Render PostgreSQL - 3 Separate Instances):
# USER_DATABASE_URL=postgresql://user_admin:password@dpg-users-01.oregon-postgres.render.com/wastedash_users
# STAFF_DATABASE_URL=postgresql://staff_admin:password@dpg-staff-01.oregon-postgres.render.com/wastedash_staff
# WASTE_DATABASE_URL=postgresql://ops_admin:password@dpg-ops-01.oregon-postgres.render.com/wastedash_operations

# Legacy single-database fallback pointer (for backward compatibility only)
DATABASE_URL=sqlite:///./waste_management.db

# ------------------------------------------------------------------------------
# 5. Dedicated Standalone AI Microservice Configuration (Section 4)
# ------------------------------------------------------------------------------
# Independently deployed Python FastAPI AI inference service URL
AI_SERVICE_BASE_URL=http://localhost:8001
AI_SERVICE_API_KEY=replace_with_secure_random_ai_service_key

# Backward-compatible aliases for legacy callers
AI_INFERENCE_URL=http://localhost:8001
AI_INFERENCE_API_KEY=replace_with_secure_random_ai_service_key

# ------------------------------------------------------------------------------
# 6. Local Model Checkpoints & Fallback Engine
# ------------------------------------------------------------------------------
MODELS_DIR=./models_checkpoints
RESNET50_WEIGHTS_PATH=models_checkpoints/waste_resnet50.pth
YOLO11N_WEIGHTS_PATH=models_checkpoints/yolo11n.pt

FALLBACK_CLASSIFICATION_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.45
FRAME_SAMPLING_INTERVAL_MS=300
MAX_IMAGE_SIZE_MB=15.0
INFERENCE_TIMEOUT_SECONDS=15.0
TRAINING_THRESHOLD=500

# ------------------------------------------------------------------------------
# 7. IoT Physical Sorting Conveyor Safety Parameters (Section 9)
# ------------------------------------------------------------------------------
IOT_SORTING_CONFIDENCE_THRESHOLD=0.70 # Minimum confidence for automated sorting
IOT_ACTUATOR_TIMEOUT_MS=250.0

# ------------------------------------------------------------------------------
# 8. Media & Asset Storage (Local Directory or S3-Compatible Cloud Storage)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET=wastedash-assets
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-south-1
MEDIA_DIR=./uploads

# ------------------------------------------------------------------------------
# 9. Adafruit IO MQTT Cloud Broker (Encrypted TLS on Port 8883)
# ------------------------------------------------------------------------------
ADAFRUIT_IO_USERNAME=your_adafruit_username
ADAFRUIT_IO_KEY=your_adafruit_io_key
ADAFRUIT_IO_HOST=io.adafruit.com
ADAFRUIT_IO_PORT=8883
ADAFRUIT_IO_USE_TLS=true
ADAFRUIT_IO_FEED_PREFIX=wastedash
ADAFRUIT_IO_FEEDS=wastedash-telemetry,wastedash-bin-fill,wastedash-scale-weight,wastedash-temperature,wastedash-humidity,wastedash-device-status

# ------------------------------------------------------------------------------
# 10. Real-Time Municipal Simulation Engine
# ------------------------------------------------------------------------------
SIMULATION_MODE=true
SIMULATION_TICK_SECONDS=8

# ------------------------------------------------------------------------------
# 11. Initial Bootstrap Credentials (Local Development Setup Only)
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@wastesegeregate.in
ADMIN_BOOTSTRAP_PASSWORD=admin123
