# ==============================================================================
# WasteDash AI Inference Microservice — Environment Configuration Template
# Greater Chennai Corporation (GCC) Municipal Solid Waste Segregation Platform
# ==============================================================================
# Independent FastAPI microservice for neural waste image classification (ResNet50)
# and live conveyor / camera frame waste object detection (YOLO11n).
# ==============================================================================

# Service Runtime
AI_SERVICE_ENV=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
DEBUG=false

# Authentication (Must match AI_SERVICE_API_KEY in backend configuration)
AI_SERVICE_API_KEY=replace_with_secure_random_ai_service_key

# Authoritative Trained Model Checkpoints & Directories
AI_MODELS_DIR=models_checkpoints
RESNET50_PATH=models_checkpoints/waste_resnet50.pth
YOLO11N_PATH=models_checkpoints/yolo11n.pt
DEVICE=cpu # 'cpu' or 'cuda' for GPU acceleration

# Inference Thresholds & Performance Limits
CONFIDENCE_THRESHOLD=0.45
SAFETY_CONFIDENCE_THRESHOLD=0.70 # Required threshold for physical sorting actuators
INFERENCE_TIMEOUT_SECONDS=15.0
MAX_IMAGE_SIZE_MB=15.0
BATCH_SIZE=16

# Repaired Multi-Cue Classical CV Fallback Engine
FALLBACK_ENABLED=true
FALLBACK_ALGORITHM=opencv_multi_cue_heuristic

# Security & CORS (Allow Backend REST API to communicate)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://waste-22.onrender.com
