# ==============================================================================
# WasteDash Frontend — Environment Configuration Template
# Greater Chennai Corporation (GCC) Municipal Solid Waste Segregation Dashboard
# ==============================================================================
# CRITICAL SECURITY RULES:
# 1. ONLY variables prefixed with NEXT_PUBLIC_ are exposed to browser JavaScript.
# 2. NEVER add database credentials, JWT secrets, S3 keys, or Adafruit IO keys here.
# 3. For local development: copy this file to .env.local (`cp .env.example .env.local`)
# 4. For Render production: set NEXT_PUBLIC_API_URL in the Frontend Web Service settings.
# ==============================================================================

# Backend REST API Base URL (must include /api prefix)
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Production Render deployment example:
# NEXT_PUBLIC_API_URL=https://waste-22.onrender.com/api

# Optional Branding & Metadata
NEXT_PUBLIC_MUNICIPALITY_NAME="Greater Chennai Corporation"
NEXT_PUBLIC_DEFAULT_CITY="Chennai"
NEXT_PUBLIC_APP_VERSION="2.2.0"
