# ==============================================================================
# WasteDash Monorepo — Unified Environment Configuration Reference
# Automated Municipal Solid Waste Segregation & AI Platform for GCC
# ==============================================================================
# This root template documents all environment variables used across the
# three services in this repository:
# 1. Backend API (FastAPI)             -> backend/.env.example
# 2. Frontend Client (Next.js)         -> frontend/.env.example
# 3. AI Inference Microservice (FastAPI) -> ai-service/.env.example
#
# FOR RENDER DEPLOYMENT:
# Refer to docs/RENDER_ENVIRONMENT_SETUP.md for copyable environment checklists
# for each distinct Render Web Service.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE CONFIGURATION (FastAPI)
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=false
PROJECT_NAME="Chennai Solid Waste Segregation & AI Optimization Platform"
API_V1_STR=/api

# Security & Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_64_char_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://waste-22.onrender.com

# Database Tier (Three Genuinely Isolated Databases)
# Local SQLite defaults:
USER_DATABASE_URL=sqlite:///./users.db
STAFF_DATABASE_URL=sqlite:///./staff.db
WASTE_DATABASE_URL=sqlite:///./waste_management.db

# Production Render PostgreSQL examples:
# USER_DATABASE_URL=postgresql://user_admin:password@dpg-users.render.com/wastedash_users
# STAFF_DATABASE_URL=postgresql://staff_admin:password@dpg-staff.render.com/wastedash_staff
# WASTE_DATABASE_URL=postgresql://ops_admin:password@dpg-ops.render.com/wastedash_operations

# File & Media Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=wastedash-assets
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-south-1

# Adafruit IO Cloud MQTT Broker (TLS Port 8883)
ADAFRUIT_IO_USERNAME=your_adafruit_username
ADAFRUIT_IO_KEY=your_adafruit_io_key
ADAFRUIT_IO_HOST=io.adafruit.com
ADAFRUIT_IO_PORT=8883
ADAFRUIT_IO_USE_TLS=true
ADAFRUIT_IO_FEED_PREFIX=wastedash
ADAFRUIT_IO_FEEDS=wastedash-telemetry,wastedash-bin-fill,wastedash-scale-weight,wastedash-temperature,wastedash-humidity,wastedash-device-status

# AI Classification & Fallback Engine
FALLBACK_CLASSIFICATION_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.45
FRAME_SAMPLING_INTERVAL_MS=300
MAX_IMAGE_SIZE_MB=15.0
INFERENCE_TIMEOUT_SECONDS=15.0
AI_INFERENCE_TIMEOUT_SECONDS=15.0
TRAINING_THRESHOLD=500

# Optional Decoupled AI Microservice
AI_INFERENCE_URL=
AI_INFERENCE_API_KEY=

# Real-Time Simulation Engine
SIMULATION_MODE=true
SIMULATION_TICK_SECONDS=8

# Initial Bootstrap Administrator (Local Dev Setup Only)
ADMIN_BOOTSTRAP_EMAIL=admin@wastesegeregate.in
ADMIN_BOOTSTRAP_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
# In Next.js, only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_MUNICIPALITY_NAME="Greater Chennai Corporation"
NEXT_PUBLIC_DEFAULT_CITY="Chennai"
NEXT_PUBLIC_APP_VERSION="2.2.0"

# ------------------------------------------------------------------------------
# 3. AI INFERENCE MICROSERVICE (Standalone Microservice)
# ------------------------------------------------------------------------------
AI_SERVICE_ENV=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_API_KEY=replace_with_secure_random_ai_service_key
MODEL_FRAMEWORK=pytorch_yolov8
MODEL_WEIGHTS_PATH=models_checkpoints/yolov8_waste.pt
FALLBACK_MODEL_PATH=models_checkpoints/classifier_v2.1.pt
DEVICE=cpu
CONFIDENCE_THRESHOLD=0.45
BATCH_SIZE=16
ALLOWED_ORIGINS=http://localhost:8000,https://waste-22.onrender.com
